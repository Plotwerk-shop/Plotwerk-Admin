# Only copy into the hosting provider's SECRET environment settings.
# Never commit real values. This file is NOT automatically loaded by the app.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Numeric ID of YOUR Shopify customer account, not a staff/user ID.
ADMIN_CUSTOMER_ID=
# Run: python3 tools/hash_password.py
ADMIN_PASSWORD_HASH=
APP_PROXY_PATH=/apps/plotwerk-admin
# Free Render deployment: use an external Neon PostgreSQL database.
DATABASE_URL=
REQUIRE_POSTGRES=true
# Only for local development or an existing persistent disk (no DATABASE_URL).
DATABASE_PATH=data/admin.sqlite3
PORT=8000
# Render Free: outbound SMTP is blocked. Use the HTTPS mail provider instead.
RESEND_API_KEY=
MAIL_FROM=info@plotwerk-shop.de
MAIL_MONTHLY_LIMIT=3000
# Optional SMTP fallback for other hosting. Never commit a mailbox password.
# SSL IMAP on 993 is used to read your existing mailbox.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@plotwerk-shop.de
SMTP_PASSWORD=
IMAP_HOST=
IMAP_USER=info@plotwerk-shop.de
IMAP_PASSWORD=
MAIL_PUBLIC_URL=https://plotwerk-admin.onrender.com
# Generate TWO separate random keys: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MAIL_SIGNING_KEY=
MAIL_WORKER_KEY=
# Adjust to your mailbox provider's sending allowance; default 100 per rolling 24 hours.
MAIL_DAILY_LIMIT=100
