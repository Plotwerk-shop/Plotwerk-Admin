# Only copy into the hosting provider's SECRET environment settings.
# Never commit real values. This file is NOT automatically loaded by the app.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Numeric ID of YOUR Shopify customer account, not a staff/user ID.
ADMIN_CUSTOMER_ID=
# Run: python3 tools/hash_password.py
ADMIN_PASSWORD_HASH=
APP_PROXY_PATH=/apps/plotwerk-admin
DATABASE_PATH=/data/admin.sqlite3
PORT=8000
